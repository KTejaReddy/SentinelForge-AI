# ============================================================
# SentinelForge AI — Environment Configuration
# Copy to .env and fill in your values. NEVER commit real keys.
# ============================================================

# --- AI (Groq) -------------------------------------------------
# Get a key at https://console.groq.com
GROQ_API_KEY=
# Configurable model. Defaults to a currently available Groq-hosted
# coding/reasoning model.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

# --- Database ---------------------------------------------------
# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./data/sentinelforge.db

# --- Scan limits ------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
SCAN_TIMEOUT_SECONDS=900
MAX_REPAIR_ITERATIONS=2
MAX_AI_CALLS_PER_SCAN=80
DEFAULT_INTENSITY=standard

# --- Sandbox ----------------------------------------------------
# Docker is used when available. Set false to force the local,
# process-isolated fallback (never execute uploaded code on the
# host outside the sandbox workspace).
DOCKER_ENABLED=true
SANDBOX_MEMORY_MB=2048
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MAX_PROCESSES=256

# --- Server -----------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
